# Copy to .env.local and fill in. Git-ignored; layered on top of .env, which is shared.
# Picked up automatically by ./local-build-deploy.sh.
#
# Run the analyst against a model on this machine instead of the Hugging Face router,
# so F1 and F2 work with no network. Leave the file absent to use the router.
#
# host.docker.internal is how the container reaches a server bound to 127.0.0.1 on the host.
#APP_AI_BASE_URL=http://host.docker.internal:8000/v1
#APP_AI_MODEL=your-local-model-id
#APP_AI_API_KEY=your-local-server-key

# After changing anything here the container must be RECREATED, not restarted -
# restart does not re-read environment:
#   ./local-build-deploy.sh -r
# Then clear any saved model override so the new default wins:
#   curl -X POST http://localhost:7860/admin/model/reset
